# Copy this file to ".env" and fill in real values. NEVER commit ".env".
APP_NAME=GymFit
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gymfit_user
DB_PASSWORD=change_me
DB_NAME=gymfit

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters long.
SECRET_KEY=change_me_to_a_long_random_string_of_32_plus_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where your frontend runs (VS Code Live Server default)
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

GYM_TIMEZONE=Asia/Kolkata

# First Admin account. Used ONCE by:  python -m app.scripts.create_admin
# Choose your own strong values. After creating the admin you may delete
# FIRST_ADMIN_PASSWORD from this file.
FIRST_ADMIN_NAME=Gym Admin
FIRST_ADMIN_EMAIL=admin@gymfit.com
FIRST_ADMIN_PASSWORD=change_me_Admin1234
